# ── Backend ─────────────────────────────────────────────────────
APP_SECRET=               # Session signing secret; use a long random value in production

# ── Database ───────────────────────────────────────────────────
MONGODB_URI=              # MongoDB connection string (mongodb+srv://user:pass@cluster.mongodb.net)
MONGODB_DATABASE=blogsor  # Database name shown in MongoDB Atlas

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Optional union ID for an admin account
